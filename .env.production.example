# Copy to .env.production on the server and fill in. Never commit .env.production.

# Your site's address, without https:// — for example skillforge-demo.duckdns.org (free at duckdns.org).
SITE_DOMAIN=

# Supabase > your project > Connect > Connection String > URI > Session pooler, with your password filled in.
# Production needs a database password of 16+ characters (reset it under Project Settings > Database).
DATABASE_URL=

# Your owner key: unlocks Claude and Codex in chat, and changing the shared skill library.
# Make one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Limits (optional). Chat replies per visitor per day, and for all visitors together.
# CHAT_TURNS_PER_DAY=50
# CHAT_TURNS_PER_DAY_TOTAL=500
# Delete a visitor's workspace after this many days unused (0: never).
# WORKSPACE_RETENTION_DAYS=30
# The local model visitors chat with.
# OLLAMA_MODEL=qwen2.5-coder:3b
