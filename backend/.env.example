# Backend settings: copy to backend/.env
APP_NAME=SkillForge API
APP_ENV=development
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Repair strategies the worker may try before asking a person to review (0-5).
REPAIR_BUDGET=2
# off: one shared local workspace, no sign-in. accounts: people sign up and sign in; each gets a private workspace.
# AUTH_MODE=off
# ALLOW_SIGNUP=true
# SESSION_DAYS=30
# Bearer token for /api/v1 (make token). Unset: open in development, closed in production.
# API_TOKEN=
# Where skills run: process (locked-down child process) or docker (throwaway container, no network,
# read-only filesystem; run make sandbox-image first). Production requires docker.
# SANDBOX_BACKEND=process
# SANDBOX_IMAGE=python:3.14-slim
# Requests per client per minute on /api/v1 (health checks are exempt).
# RATE_LIMIT_WRITES_PER_MINUTE=60
# RATE_LIMIT_READS_PER_MINUTE=600
# Model budget: agent chat replies per workspace per 24 hours.
# CHAT_TURNS_PER_DAY=200
