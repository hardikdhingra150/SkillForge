# Backend settings: copy to backend/.env
APP_NAME=SkillForge API
APP_ENV=development
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Repair strategies the worker may try before asking a person to review (0-5).
REPAIR_BUDGET=2
# Optional API-key providers (needed when SkillForge is deployed; the CLIs are for local use).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
